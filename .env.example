# Database — local Postgres (docker-compose) on host port 1832
DATABASE_URL="postgres://vierra:vierra@localhost:1832/vierra"

# API (Hono on Node)
API_PORT="1800"
NEXT_PUBLIC_API_URL="http://localhost:1800"
ALLOWED_ORIGINS="http://localhost:1803,http://localhost:1804"

# Web (Next.js public site)
WEB_PORT="1803"

# CMS (Next.js admin)
CMS_PORT="1804"

# Revalidation hook (cms → web)
REVALIDATE_SECRET="change-me"

